---
import { url } from '../lib/url';
---
<figure class="personal-portrait avatar-frame" data-avatar>
  <svg viewBox="0 0 400 500" role="img" aria-label="Illustrated portrait of Muhammad Irfan Waseem in a navy suit and burgundy tie">
    <defs>
      <radialGradient id="avatar-back"><stop stop-color="#3d6474"/><stop offset="1" stop-color="#111b29"/></radialGradient>
      <linearGradient id="avatar-suit"><stop stop-color="#344961"/><stop offset="1" stop-color="#111a2d"/></linearGradient>
      <linearGradient id="avatar-skin" x2="1" y2="1"><stop stop-color="#f4bf97"/><stop offset="1" stop-color="#b97860"/></linearGradient>
    </defs>
    <rect width="400" height="500" fill="url(#avatar-back)"/>
    <path d="M34 410V105h332v305M62 92v-9h22m254 0h-22m22 0v23M28 410h344" fill="none" stroke="#a4d9dc" opacity=".27"/>
    <circle cx="200" cy="194" r="119" fill="none" stroke="#afe3df" opacity=".18"/>
    <g class="avatar-body">
      <path d="M24 500l17-104q7-44 45-59l77-31h74l77 31q38 15 45 59l17 104" fill="url(#avatar-suit)" stroke="#56697f" stroke-width="2"/>
      <path d="M166 268h68v55l-34 32-34-32z" fill="#b47a64"/>
      <path d="M160 308l40 29 40-29 32 192H128z" fill="#233249"/>
      <path d="M161 311l39 26 39-26-39 123z" fill="#e4e7e7"/>
      <path d="M191 337h18l6 13-8 13 9 31-16 40-15-40 8-31-8-13z" fill="#842b45"/>
      <path d="M160 311l-29 21-11 56 32 5-16 19 40 88h24zm80 0 29 21 11 56-32 5 16 19-40 88h-24z" fill="url(#avatar-suit)" stroke="#596b80"/>
      <path d="M269 431h43m-225 0h30" stroke="#56697f" stroke-width="2"/>
    </g>
    <g class="avatar-head">
      <path d="M134 195q-24-12-19 14 3 29 26 31m125-45q24-12 19 14-3 29-26 31" fill="#bd826b"/>
      <path d="M131 153q7-58 69-58t69 58l-3 72q-4 30-25 51l-23 20q-18 11-36 0l-23-20q-21-21-25-51z" fill="url(#avatar-skin)"/>
      <path d="M132 191q-14-19-10-43-11-20 4-39-2-25 25-37 13-27 45-21 23-14 48 2 34-3 40 26 15 13 4 32 5 22-20 68l-6-36q-10-17-20-22-40 15-77-7-18 16-25 40z" fill="#161a24"/>
      <path d="M130 125q11-40 55-58 41-15 77 5-39-7-78 18-28 15-54 35m19-3q43-46 104-37-19 24-59 24-29 3-45 13" fill="#303544"/>
      <path d="M146 182q17-12 36-2m36 0q19-10 36 2" fill="none" stroke="#332728" stroke-width="5" stroke-linecap="round"/>
      <g class="avatar-eyes">
        <path d="M146 197q17-13 36 0-19 11-36 0m72 0q19-13 36 0-17 11-36 0" fill="#fff0df" stroke="#653c34" stroke-width="2"/>
        <g class="avatar-gaze" fill="#392822"><circle cx="164" cy="197" r="5"/><circle cx="236" cy="197" r="5"/><path d="M162 195h2m70 0h2" stroke="#fff4dc" stroke-width="1.5"/></g>
      </g>
      <path d="M199 198l-7 29q8 6 17 0" fill="none" stroke="#a96957" stroke-width="2" stroke-linecap="round"/>
      <path d="M148 243q18 36 52 38 32-2 52-38-10 36-33 50-19 13-38 0-23-14-33-50" fill="#44302d" opacity=".82"/>
      <path d="M177 248q23-11 46 0-23 13-46 0" fill="#945449"/>
      <path d="M183 248q17 5 34 0" fill="none" stroke="#62403d" stroke-width="2"/>
    </g>
  </svg>
  <figcaption><a href={url('images/Irfan.webp')}>View original photograph</a></figcaption>
</figure>

<style>
  .avatar-frame { overflow: hidden; }
  svg { display: block; width: 100%; height: auto; }
  figcaption { padding: .5rem .25rem .12rem; font-size: .8rem; }
  figcaption a { text-decoration: underline; text-underline-offset: .2em; }
  .avatar-head, .avatar-gaze { transition: transform 200ms ease-out; }
  .avatar-head { transform-origin: 200px 282px; transform: translate(var(--head-x, 0px), var(--head-y, 0px)) rotate(var(--head-roll, 0deg)); }
  .avatar-gaze { transform: translate(var(--eye-x, 0px), var(--eye-y, 0px)); }
  .avatar-body { transform-origin: 200px 500px; }
  .avatar-eyes { transform-origin: 200px 197px; }
  [data-avatar-active] .avatar-body { animation: breathe 4.8s ease-in-out infinite; }
  [data-avatar-active] .avatar-eyes { animation: blink 5.6s infinite; }
  @keyframes breathe { 50% { transform: scaleY(1.012); } }
  @keyframes blink { 0%, 91%, 96%, 100% { transform: scaleY(1); } 93%, 94% { transform: scaleY(.12); } }
  @media (prefers-reduced-motion: reduce) {
    .avatar-head, .avatar-gaze { transition: none; }
    [data-avatar-active] .avatar-body, [data-avatar-active] .avatar-eyes { animation: none; }
  }
</style>

<script>
  const avatar = document.querySelector<HTMLElement>('[data-avatar]');
  const hero = avatar?.closest<HTMLElement>('.personal-hero');
  const motion = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');

  if (avatar && hero) {
    let visible = false;
    let frame = 0;
    let x = 0;
    let y = 0;
    const clamp = (value: number) => Math.max(-1, Math.min(1, value));
    const draw = () => {
      frame = 0;
      avatar.style.setProperty('--head-x', x * 7 + 'px');
      avatar.style.setProperty('--head-y', y * 4 + 'px');
      avatar.style.setProperty('--head-roll', x * 3 + 'deg');
      avatar.style.setProperty('--eye-x', x * 3 + 'px');
      avatar.style.setProperty('--eye-y', y * 1.5 + 'px');
    };
    const reset = () => {
      cancelAnimationFrame(frame);
      x = y = 0;
      draw();
    };
    const update = () => {
      const active = visible && motion.matches && !document.hidden;
      avatar.toggleAttribute('data-avatar-active', active);
      if (!active) reset();
    };
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      update();
    });
    observer.observe(avatar);
    hero.addEventListener('pointermove', event => {
      if (event.pointerType !== 'mouse' || !avatar.hasAttribute('data-avatar-active')) return;
      const bounds = hero.getBoundingClientRect();
      x = clamp((event.clientX - bounds.left) / bounds.width * 2 - 1);
      y = clamp((event.clientY - bounds.top) / bounds.height * 2 - 1);
      if (!frame) frame = requestAnimationFrame(draw);
    });
    hero.addEventListener('pointerleave', reset);
    motion.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
  }
</script>
