---
import { url } from '../lib/url';

const { slug } = Astro.props as { slug: string };
const screenshots: Record<string, { file: string; caption: string; width: number; height: number }[]> = {
  eduquest: [
    { file: 'eduquest-subjects.webp', caption: 'Subject picker with mathematics, programming and language practice', width: 1280, height: 800 },
    { file: 'eduquest-modes.webp', caption: 'Mathematics game modes with quizzes, matching and timed challenges', width: 1280, height: 800 },
  ],
  'previous-portfolio': [
    { file: 'portfolio-contact.webp', caption: 'Portfolio contact page with direct email and inquiry form fields', width: 1280, height: 800 },
    { file: 'portfolio-projects.webp', caption: 'Featured project cards and category filters', width: 1280, height: 800 },
    { file: 'portfolio-mobile.webp', caption: 'Mobile home page in the light theme', width: 390, height: 844 },
  ],
};
const captures: Record<string, string[]> = {
  'food-fight': ['Menu', 'Checkout', 'Tracking', 'Branch queue', 'Rider delivery'],
  teamsync: ['Workspace', 'Projects', 'Board', 'Task detail', 'Member roles'],
  'ittehad-food-industries': ['Procurement', 'Processing batch', 'Inventory', 'Dispatch'],
  'mandi-pro-erp': ['Dashboard', 'Transaction', 'Ledger', 'Report'],
  'hire-ready': ['Interview setup', 'Question', 'Completed session', 'Feedback'],
  saqib: ['Product list', 'Product detail', 'Cart', 'Order flow'],
  eduquest: ['Active quiz or results'],
  'python-logic-building': ['Repository overview', 'Exercise prompt', 'Solution', 'Terminal output'],
  'learn-dart': ['Repository overview', 'Lesson', 'Runnable example', 'Program output'],
};
const images = screenshots[slug] ?? [];
if (slug === 'eduquest') images.unshift({file:'eduquest-home.webp',caption:'EduQuest home screen',width:1280,height:800});
if (slug === 'previous-portfolio') images.unshift({file:'portfolio-home.webp',caption:'Developer portfolio home page',width:1280,height:800});
---
<section class="wrap case-screenshots" aria-labelledby="case-screenshots-title">
  <h2 id="case-screenshots-title">Project screenshots</h2>
  <div class="screenshots-grid">
    {images.map(({ file, caption, width, height }) => (
      <figure>
        <a href={url(`images/projects/${file}`)} aria-label={`Open full-size screenshot: ${caption}`}>
          <img src={url(`images/projects/${file}`)} alt={caption} width={width} height={height} loading="lazy" decoding="async"/>
        </a>
        <figcaption>{caption}</figcaption>
      </figure>
    ))}
    {captures[slug]?.map(caption => <p class="notice">[ADD: {caption} screenshot]</p>)}
  </div>
  {images.length > 0 && <dialog aria-label="Project screenshot">
    <div class="gallery-controls">
      <button type="button" data-action="close" autofocus>Close image</button>
      {images.length > 1 && <>
        <button type="button" data-action="previous">Previous image</button>
        <button type="button" data-action="next">Next image</button>
      </>}
    </div>
    <img alt="" />
    <p class="gallery-caption" aria-live="polite"></p>
  </dialog>}
</section>
<style>
  .case-screenshots { padding-block: clamp(2rem, 6vw, 5rem); }
  .screenshots-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  figure { margin: 1rem 0 0; border-top: 1px solid var(--line); padding-top: 1rem; }
  img { display: block; max-width: 100%; width: auto; height: auto; max-height: 34rem; object-fit: contain; }
  figcaption { margin-top: .75rem; color: var(--muted); }
  @media (max-width: 650px) { .screenshots-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const gallery = document.querySelector('.case-screenshots');
  const dialog = gallery?.querySelector('dialog');
  const image = dialog?.querySelector('img');
  const caption = dialog?.querySelector('.gallery-caption');
  const links = Array.from(gallery?.querySelectorAll<HTMLAnchorElement>('figure a') ?? []);

  if (dialog && image && caption && typeof dialog.showModal === 'function') {
    let current = 0;
    let opener: HTMLAnchorElement;
    const show = (index: number) => {
      current = (index + links.length) % links.length;
      const link = links[current];
      image.src = link.href;
      image.alt = link.querySelector('img')?.alt ?? '';
      caption.textContent = (current + 1) + ' of ' + links.length + ' · ' + image.alt;
    };
    dialog.querySelector('[data-action="close"]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-action="previous"]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-action="next"]')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', event => {
      if (links.length < 2 || (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight')) return;
      event.preventDefault();
      show(current + (event.key === 'ArrowLeft' ? -1 : 1));
    });
    dialog.addEventListener('close', () => opener?.focus());
    links.forEach((link, index) => link.addEventListener('click', event => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      opener = link;
      show(index);
      dialog.showModal();
    }));
  }
</script>
<style>
  dialog { max-width: 92vw; max-height: 90vh; background: var(--surface); color: var(--text); border: 1px solid var(--line); }
  .gallery-controls { display: flex; flex-wrap: wrap; gap: .5rem; }
  .gallery-caption { margin-bottom: 0; }
  dialog img { max-height: 72vh; margin-top: .75rem; }
  dialog::backdrop { background: #080b12dd; }
</style>
