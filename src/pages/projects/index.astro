---
import Base from '../../layouts/Base.astro';import ProjectCard from '../../components/ProjectCard.astro';import {projects} from '../../data/projects';
const categories=[['all','All projects'],['mobile','Mobile'],['web','Web'],['erp','ERP systems'],['ai','AI'],['education','Learning']];
---
<Base title="Selected Work — Muhammad Irfan Waseem" description="Explore Flutter, MERN and business software projects by Muhammad Irfan Waseem."><header class="page-head wrap"><p class="eyebrow">WORK & EXPLORATIONS</p><h1>Software with<br/><em>a real purpose.</em></h1><p>Mobile ordering, business operations and collaborative workspaces. Explore the problem, the implementation and the current state of each project.</p></header><section class="page-body wrap gallery" aria-label="Project gallery"><div class="toolbar"><div class="filters" role="group" aria-label="Filter projects">{categories.map(([id,label])=><button data-filter={id} aria-pressed={id==='all'}>{label}</button>)}</div><label>Search projects<input id="project-search" type="search" placeholder="Search names or technologies"/></label><div><label for="project-technology">Technology</label><select id="project-technology"><option value="">All technologies</option>{[...new Set(projects.flatMap(project => project.tags))].sort().map(tag => <option value={tag}>{tag}</option>)}</select></div></div><p class="results" id="project-count" aria-live="polite">{projects.length} projects</p><div class="project-grid">{projects.map(project=><ProjectCard project={project}/>)}</div><p id="project-empty" class="empty" hidden>No projects match your search. Try a different search or filter.</p><noscript><p class="notice">All projects are shown. Search and filters require JavaScript.</p></noscript></section></Base>
