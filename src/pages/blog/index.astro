---
import Base from '../../layouts/Base.astro';import {url} from '../../lib/url';
const modules=import.meta.glob('../../content/blog/*.md',{eager:true});
type Article={frontmatter:{title:string;description:string;date?:string;tags?:string[]};rawContent:()=>string};
const articles=Object.entries(modules).map(([path,value])=>({slug:path.split('/').pop()!.replace(/\.md$/,''),...value as Article}));
---
<Base title="Engineering Writing — Muhammad Irfan Waseem" description="Writing by Muhammad Irfan Waseem on mobile apps, connected software and security."><header class="page-head wrap"><p class="eyebrow">NOTES FROM THE WORKBENCH</p><h1>Engineering<br/><em>in words.</em></h1><p>Space for practical notes about building mobile apps and connected software.</p></header><section class="wrap page-body article-list">{articles.length ? articles.map(article=><article><h2><a href={url(`blog/${article.slug}/`)}>{article.frontmatter.title}</a></h2><p>{article.frontmatter.description}</p><div class="tags">{article.frontmatter.tags?.map(tag=><span>{tag}</span>)}</div><small>{Math.max(1,Math.ceil(article.rawContent().split(/\s+/).length/220))} minute read</small></article>) : <div class="empty"><h2>No articles published here yet.</h2><p>In the meantime, the project case studies describe the work and link to its implementation.</p><a class="text-link" href={url('projects/')}>Read the project case studies</a></div>}</section></Base>
